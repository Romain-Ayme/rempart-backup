#: includes/class-admin.php:259
msgid "Backup Guard"
msgstr "Backup Guard"

#. Description of the plugin
#: backup-guard.php
msgid "Sauvegarde, restauration, migration et clonage de WordPress. Toutes les fonctions sont incluses, sans licence : planification, rotation, FTP, FTPS, SFTP, WebDAV, Amazon S3 et compatibles, Google Drive, OneDrive, Dropbox, pCloud et WP-CLI."
msgstr "Backup, restore, migration and cloning for WordPress. Every feature is included, no licence: scheduling, rotation, FTP, FTPS, SFTP, WebDAV, Amazon S3 and compatible, Google Drive, OneDrive, Dropbox, pCloud and WP-CLI."

