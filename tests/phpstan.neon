includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 3
	paths:
		- ../includes
		- ../rempart-backup.php
		- ../uninstall.php
	scanFiles:
		- ../rempart-backup.php
	scanDirectories:
		- ../vendor
	ignoreErrors:
		# WP-CLI and wp-config.php define these only when the plugin runs inside WordPress or WP-CLI.
		- identifier: class.notFound
		  message: '#WP_CLI#'
		- identifier: function.notFound
		  message: '#WP_CLI#'
		- identifier: constant.notFound
		  message: '#^Constant DB_[A-Z]+ not found\.$#'
		# Defined in rempart-backup.php from plugins_url(), a value PHPStan does not evaluate.
		- identifier: constant.notFound
		  message: '#^Constant REMPART_URL not found\.$#'
	tmpDir: .phpstan.cache
