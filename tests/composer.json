{
	"name": "backup-guard/backup-guard-tests",
	"description": "Outils de contrôle du plugin : tests, analyse statique, style et compatibilité PHP. Non livrés avec le plugin.",
	"type": "project",
	"license": "LGPL-2.1-only",
	"private": true,
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.4",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"squizlabs/php_codesniffer": "^3.10",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "@php lint.php",
		"compat": "phpcs --standard=phpcs.xml.dist",
		"stan": "phpstan analyse --memory-limit=1G --no-progress",
		"unit": "phpunit",
		"check": [
			"@lint",
			"@compat",
			"@stan",
			"@unit"
		]
	}
}
